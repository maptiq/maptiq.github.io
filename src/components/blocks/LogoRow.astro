---
interface Props {
  heading?: string;
  background?: 'white' | 'light' | 'dark';
  items: { image: string; name: string; link?: string }[];
}

const { heading, background = 'white', items } = Astro.props;
---

<section class:list={['logo-section', `bg-${background}`]}>
  <div class="container">
    {heading && <p class="logo-heading">{heading}</p>}
    <ul class="logo-row" style={`--logo-cols:${Math.ceil(items.length / 2)}`}>
      {items.map((logo) => (
        <li>
          {logo.link ? (
            <a href={logo.link} target="_blank" rel="noopener" title={logo.name}>
              <img src={logo.image} alt={logo.name} loading="lazy" />
            </a>
          ) : (
            <img src={logo.image} alt={logo.name} title={logo.name} loading="lazy" />
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logo-section {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-neutral-light);
  }

  .logo-heading {
    margin: 0 0 var(--space-md);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Two even rows from tablet width up, two columns on phones */
  .logo-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) {
    .logo-row {
      grid-template-columns: repeat(var(--logo-cols), 1fr);
    }
  }

  .logo-row li {
    display: flex;
    justify-content: center;
  }

  .logo-row img {
    display: block;
    width: 100%;
    height: 48px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  @media (min-width: 1000px) {
    .logo-row img {
      height: 60px;
    }
  }

  .logo-row a {
    display: block;
    width: 100%;
  }

  .logo-row a:hover img,
  .logo-row a:focus-visible img,
  .logo-row img:hover {
    filter: none;
    opacity: 1;
  }
</style>
